{
  "name": "EmailFeed",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Owner's account email (tenant key)"
    },
    "user_id": {
      "type": "string",
      "description": "Owner's user id"
    },
    "unique_email": {
      "type": "string",
      "description": "Private inbound address (lowercase) that newsletters are sent or forwarded to"
    },
    "mailgun_route_id": {
      "type": "string",
      "description": "Legacy per-user Mailgun route id (current setup uses one catch-all route stored in SyncState key mailgun_inbound_route)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this address is accepting messages"
    },
    "total_received": {
      "type": "number",
      "default": 0,
      "description": "Total number of emails received"
    },
    "last_email_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the last email was received"
    }
  },
  "required": [
    "user_email",
    "unique_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}