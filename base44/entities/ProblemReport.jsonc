{
  "name": "ProblemReport",
  "properties": {
    "admin_notes": {
      "description": "Private notes for admin",
      "type": "string"
    },
    "browser_info": {
      "description": "Browser and device information",
      "type": "string"
    },
    "description": {
      "description": "Detailed description of the issue",
      "type": "string"
    },
    "page": {
      "description": "Page/section where the problem occurred",
      "type": "string"
    },
    "priority": {
      "default": "medium",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "status": {
      "default": "open",
      "description": "Status of the report",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "type": "string"
    },
    "title": {
      "description": "Brief title of the problem",
      "type": "string"
    },
    "user_email": {
      "description": "Email of the user who reported the issue",
      "type": "string"
    }
  },
  "required": [
    "title",
    "description"
  ],
  "rls": {
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}