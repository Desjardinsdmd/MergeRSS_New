{
  "name": "Workspace",
  "type": "object",
  "description": "Team workspace. Written and read only through the backend function `workspace` (service role, explicit membership checks).",
  "properties": {
    "name": {
      "type": "string",
      "description": "Workspace display name"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the workspace owner (billing contact)"
    },
    "plan": {
      "type": "string",
      "enum": [
        "none",
        "team"
      ],
      "default": "none",
      "description": "team = active Team subscription (set only by stripeWebhook)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "deleted"
      ],
      "default": "active"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "subscription_status": {
      "type": "string",
      "description": "Raw Stripe subscription status for the Team plan"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "slack_webhook_url": {
      "type": "string"
    },
    "discord_webhook_url": {
      "type": "string"
    },
    "teams_webhook_url": {
      "type": "string"
    },
    "seat_limit": {
      "type": "number",
      "default": 5,
      "description": "Max members (owner included) on the Team plan"
    }
  },
  "required": [
    "name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}