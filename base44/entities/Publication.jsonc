{
  "name": "Publication",
  "properties": {
    "auto_post": {
      "default": false,
      "description": "If true, drafts auto-post without human approval. Default false.",
      "type": "boolean"
    },
    "candidates_per_run": {
      "default": 3,
      "description": "How many top-ranked clusters to surface as candidates each scheduled run",
      "type": "number"
    },
    "channel_type": {
      "default": "x",
      "enum": [
        "x",
        "linkedin",
        "newsletter",
        "slack",
        "discord",
        "manual"
      ],
      "type": "string"
    },
    "credentials_ref": {
      "description": "Reference to encrypted channel credentials stored separately.",
      "type": "string"
    },
    "last_run_at": {
      "format": "date-time",
      "type": "string"
    },
    "lens_id": {
      "description": "CustomLens used for story selection",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "next_run_at": {
      "format": "date-time",
      "type": "string"
    },
    "post_format_config": {
      "additionalProperties": true,
      "description": "Channel-specific format config. For X: { max_chars: 280, supports_threads: true, hashtag_policy: 'minimal', link_placement: 'end' }",
      "type": "object"
    },
    "preferred_variant": {
      "default": "wire",
      "description": "Which draft variant to auto-select. Used as chosen_variant_index when auto_post is on, and as default selection in manual review.",
      "enum": [
        "wire",
        "thread",
        "take"
      ],
      "type": "string"
    },
    "schedule_cron": {
      "description": "Cron expression(s) for when to generate drafts, comma-separated. e.g. '0 11 * * *,0 16 * * *'",
      "type": "string"
    },
    "status": {
      "default": "draft_only",
      "description": "draft_only = generate drafts but never post even if auto_post=true",
      "enum": [
        "active",
        "paused",
        "draft_only"
      ],
      "type": "string"
    },
    "timezone": {
      "default": "America/Toronto",
      "type": "string"
    },
    "voice_prompt": {
      "description": "Writer prompt \u2014 voice, format, constraints. User-editable.",
      "type": "string"
    }
  },
  "required": [
    "name",
    "channel_type",
    "lens_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}