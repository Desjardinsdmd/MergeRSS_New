{
  "name": "FeedAlert",
  "properties": {
    "channel_type": {
      "description": "Where to send alerts",
      "enum": [
        "slack",
        "discord"
      ],
      "type": "string"
    },
    "feed_id": {
      "description": "Reference to the Feed",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "type": "boolean"
    },
    "label": {
      "description": "Optional label for this alert",
      "type": "string"
    },
    "last_sent": {
      "format": "date-time",
      "type": "string"
    },
    "webhook_url": {
      "description": "Webhook URL to post to",
      "type": "string"
    }
  },
  "required": [
    "feed_id",
    "channel_type",
    "webhook_url"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}