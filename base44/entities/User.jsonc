{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "setup_walkthrough_complete": {
      "type": "boolean",
      "default": false
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "login_streak": {
      "type": "number",
      "default": 0,
      "description": "Number of consecutive days the user has visited"
    },
    "last_visit_date": {
      "type": "string",
      "description": "Date string of the user's last visit"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone name (e.g. America/Toronto). Default for new digests and date display."
    },
    "notification_prefs": {
      "type": "object",
      "additionalProperties": true,
      "description": "Email notification toggles. Keys read by the backend: emailNotifications (master switch), digestReminders (digest skipped/stalled alerts), feedErrors (feed auto-paused alerts). Missing keys default to on."
    },
    "interest_profile": {
      "type": "string",
      "description": "Free-text description of what matters to this user. Enrichment scores the importance of their articles against it."
    },
    "interest_field": {
      "type": "string",
      "description": "Short label for the user's field (e.g. Multifamily development)"
    },
    "workspace_id": {
      "type": "string",
      "description": "Active team workspace id, if the user belongs to one"
    },
    "newsletter_address": {
      "type": "string",
      "description": "Per-user inbound newsletter address"
    }
  },
  "required": [
    "last_visit_date"
  ]
}