{
  "name": "RepairJob",
  "properties": {
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "current_feed_id": {
      "type": "string"
    },
    "current_feed_name": {
      "type": "string"
    },
    "deleted_count": {
      "default": 0,
      "type": "number"
    },
    "failed_count": {
      "default": 0,
      "type": "number"
    },
    "feed_ids_snapshot": {
      "description": "IDs of all feeds captured at job start",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "last_heartbeat_at": {
      "format": "date-time",
      "type": "string"
    },
    "processed_count": {
      "default": 0,
      "type": "number"
    },
    "quarantined_count": {
      "default": 0,
      "type": "number"
    },
    "repaired_count": {
      "default": 0,
      "type": "number"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "default": "idle",
      "enum": [
        "idle",
        "running",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "summary": {
      "additionalProperties": true,
      "description": "Final summary with breakdown by failure category",
      "type": "object"
    },
    "total_count": {
      "default": 0,
      "type": "number"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}