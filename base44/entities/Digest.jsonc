{
  "name": "Digest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Digest name"
    },
    "description": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categories to include"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags to filter by"
    },
    "feed_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific feeds to include"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly"
      ],
      "default": "daily"
    },
    "schedule_time": {
      "type": "string",
      "description": "Time to send (HH:MM format)"
    },
    "schedule_day_of_week": {
      "type": "number",
      "description": "Day of week for weekly digests (0=Sunday, 6=Saturday)"
    },
    "schedule_day_of_month": {
      "type": "number",
      "description": "Day of month for monthly digests (1-31)"
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "output_length": {
      "type": "string",
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "default": "medium"
    },
    "delivery_web": {
      "type": "boolean",
      "default": true
    },
    "delivery_email": {
      "type": "boolean",
      "default": false,
      "description": "Send digest to user's email"
    },
    "delivery_slack": {
      "type": "boolean",
      "default": false
    },
    "delivery_discord": {
      "type": "boolean",
      "default": false
    },
    "delivery_teams": {
      "type": "boolean",
      "default": false,
      "description": "Send digest to Microsoft Teams"
    },
    "slack_channel_id": {
      "type": "string"
    },
    "discord_webhook_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused"
      ],
      "default": "active"
    },
    "last_sent": {
      "type": "string",
      "format": "date-time"
    },
    "next_scheduled": {
      "type": "string",
      "format": "date-time"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "Whether this digest is listed in the public directory"
    },
    "public_description": {
      "type": "string",
      "description": "Short description shown in the public directory"
    },
    "added_count": {
      "type": "number",
      "default": 0,
      "description": "How many users have added this digest from the directory"
    },
    "upvotes": {
      "type": "number",
      "default": 0
    },
    "downvotes": {
      "type": "number",
      "default": 0
    },
    "metadata_json": {
      "type": "string",
      "description": "Internal run metadata (last delivery nonce etc.)"
    },
    "consecutive_skips": {
      "type": "number",
      "default": 0,
      "description": "Scheduled slots in a row that were skipped without sending. Reset on a successful send."
    },
    "last_skip_reason": {
      "type": "string",
      "description": "Why the most recent scheduled slot was skipped"
    },
    "last_skip_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the most recent skip was recorded"
    },
    "last_notified_skip_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the owner was last emailed about this digest being skipped"
    },
    "last_evaluated_slot": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled slot most recently evaluated (sent or skipped), so a skipped slot is not re-evaluated every hour"
    },
    "auto_adjustment_note": {
      "type": "string",
      "description": "What the system changed or ignored to keep this digest sending (pruned feeds, ignored tags)"
    },
    "workspace_id": {
      "type": "string",
      "description": "Team workspace this briefing is shared with. Set only by saveDigest for workspace owners/editors."
    }
  },
  "required": [
    "name",
    "frequency"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}