{
  "name": "Integration",
  "properties": {
    "access_token": {
      "type": "string"
    },
    "channels": {
      "items": {
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "refresh_token": {
      "type": "string"
    },
    "selected_channel_id": {
      "type": "string"
    },
    "selected_channel_name": {
      "type": "string"
    },
    "status": {
      "default": "disconnected",
      "enum": [
        "connected",
        "disconnected",
        "error"
      ],
      "type": "string"
    },
    "token_expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "type": {
      "enum": [
        "slack",
        "discord",
        "teams"
      ],
      "type": "string"
    },
    "webhook_url": {
      "description": "Webhook URL for Discord, Teams, or Slack",
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "workspace_name": {
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}