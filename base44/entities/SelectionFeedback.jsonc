{
  "name": "SelectionFeedback",
  "properties": {
    "action": {
      "description": "What happened to this cluster",
      "enum": [
        "manual_select",
        "auto_select",
        "skip",
        "reject"
      ],
      "type": "string"
    },
    "cluster_category": {
      "type": "string"
    },
    "cluster_id": {
      "type": "string"
    },
    "cluster_source_count": {
      "type": "number"
    },
    "cluster_title": {
      "type": "string"
    },
    "lens_id": {
      "type": "string"
    },
    "lens_score": {
      "description": "The lens importance score at time of decision",
      "type": "number"
    },
    "original_score": {
      "description": "The combined score at time of decision",
      "type": "number"
    },
    "publication_id": {
      "type": "string"
    },
    "user_notes": {
      "type": "string"
    }
  },
  "required": [
    "publication_id",
    "cluster_id",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}