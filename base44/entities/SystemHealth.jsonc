{
  "name": "SystemHealth",
  "properties": {
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "job_type": {
      "enum": [
        "feed_fetch",
        "digest_generation",
        "slack_delivery",
        "discord_delivery"
      ],
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "type": "object"
    },
    "retry_count": {
      "default": 0,
      "type": "number"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "scheduled"
      ],
      "type": "string"
    }
  },
  "required": [
    "job_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}