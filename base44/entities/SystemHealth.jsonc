{
  "name": "SystemHealth",
  "properties": {
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "job_type": {
      "type": "string",
      "description": "Free-form job type. Was an enum of 4 values, which silently rejected clustering, scoring, recovery, migration and health logs."
    },
    "metadata": {
      "additionalProperties": true,
      "type": "object"
    },
    "retry_count": {
      "default": 0,
      "type": "number"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "scheduled"
      ],
      "type": "string"
    }
  },
  "required": [
    "job_type",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}