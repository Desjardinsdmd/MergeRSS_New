{
  "name": "SystemHealth",
  "type": "object",
  "properties": {
    "job_type": {
      "type": "string",
      "enum": [
        "feed_fetch",
        "digest_generation",
        "slack_delivery",
        "discord_delivery"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed",
        "scheduled"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_message": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "retry_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "job_type",
    "status"
  ]
}