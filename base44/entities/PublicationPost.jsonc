{
  "name": "PublicationPost",
  "properties": {
    "candidate_pool": {
      "description": "Other cluster_ids that were considered for this slot",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "chosen_variant_index": {
      "description": "Which variant the user approved (0-indexed)",
      "type": "number"
    },
    "cluster_id": {
      "description": "Selected StoryCluster ID",
      "type": "string"
    },
    "draft_variants": {
      "description": "Generated draft options",
      "items": {
        "properties": {
          "content": {
            "description": "One element for single post; multiple for thread",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "label": {
            "description": "e.g. 'wire', 'thread', 'take'",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "engagement_metrics": {
      "properties": {
        "bookmarks": {
          "type": "number"
        },
        "fetched_at": {
          "format": "date-time",
          "type": "string"
        },
        "impressions": {
          "type": "number"
        },
        "likes": {
          "type": "number"
        },
        "replies": {
          "type": "number"
        },
        "reposts": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "error_message": {
      "description": "Set if status=failed",
      "type": "string"
    },
    "external_post_ids": {
      "description": "X tweet IDs after posting",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "final_content": {
      "description": "The actual posted content after any human edits",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "human_notes": {
      "type": "string"
    },
    "posted_at": {
      "format": "date-time",
      "type": "string"
    },
    "publication_id": {
      "type": "string"
    },
    "scheduled_for": {
      "format": "date-time",
      "type": "string"
    },
    "selection_reason": {
      "description": "LLM-generated rationale for why this cluster was selected over others",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "approved",
        "scheduled",
        "posted",
        "rejected",
        "archived",
        "failed"
      ],
      "type": "string"
    }
  },
  "required": [
    "publication_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}