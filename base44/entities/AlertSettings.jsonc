{
  "name": "AlertSettings",
  "properties": {
    "destination_email": {
      "description": "Email address to send system alerts to. If empty, all admin users are emailed.",
      "type": "string"
    },
    "frequency_hours": {
      "default": 24,
      "description": "How often (in hours) the scheduled alert check runs",
      "type": "number"
    }
  },
  "required": [],
