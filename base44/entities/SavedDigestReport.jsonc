{
  "name": "SavedDigestReport",
  "properties": {
    "actual_end": {
      "type": "string"
    },
    "actual_start": {
      "type": "string"
    },
    "delivery_count": {
      "type": "number"
    },
    "digest_ids": {
      "description": "IDs of digests analyzed",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "digest_name": {
      "description": "Combined label for the digests",
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "report": {
      "additionalProperties": true,
      "description": "Full AI-generated report object",
      "type": "object"
    },
    "start_date": {
      "type": "string"
    }
  },
  "required": [
    "digest_name",
    "report"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}