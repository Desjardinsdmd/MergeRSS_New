{
  "name": "Bookmark",
  "properties": {
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "feed_item_id": {
      "description": "Reference to the bookmarked FeedItem",
      "type": "string"
    },
    "is_read": {
      "default": false,
      "type": "boolean"
    },
    "published_date": {
      "format": "date-time",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    }
  },
  "required": [
    "feed_item_id",
    "title",
    "url"
  ],
  "rls": {
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "type": "object"
}