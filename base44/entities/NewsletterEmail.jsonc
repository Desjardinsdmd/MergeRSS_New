{
  "name": "NewsletterEmail",
  "type": "object",
  "properties": {
    "gmail_message_id": {
      "type": "string",
      "description": "Gmail message ID for deduplication"
    },
    "subscription_id": {
      "type": "string",
      "description": "Reference to the EmailSubscription that matched"
    },
    "from_email": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "text_content": {
      "type": "string",
      "description": "Plain text body"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "description": "Extracted hyperlinks from the email body"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the user who owns this record (tenant key)"
    }
  },
  "required": [
    "gmail_message_id",
    "subject",
    "from_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}