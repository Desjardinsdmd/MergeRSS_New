{
  "name": "Subscription",
  "properties": {
    "cancel_at_period_end": {
      "default": false,
      "type": "boolean"
    },
    "current_period_end": {
      "format": "date-time",
      "type": "string"
    },
    "current_period_start": {
      "format": "date-time",
      "type": "string"
    },
    "plan": {
      "default": "free",
      "enum": [
        "free",
        "premium"
      ],
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "canceled",
        "past_due",
        "trialing"
      ],
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "user_id": {
      "description": "Reference to the user who owns this subscription",
      "type": "string"
    }
  },
  "required": [
    "plan",
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}