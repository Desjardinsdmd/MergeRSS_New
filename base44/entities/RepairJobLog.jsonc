{
  "name": "RepairJobLog",
  "properties": {
    "action": {
      "description": "Outcome of the repair attempt",
      "enum": [
        "repaired",
        "quarantined",
        "failed",
        "skipped"
      ],
      "type": "string"
    },
    "diagnostics": {
      "additionalProperties": true,
      "description": "Detailed diagnostics: http_status, redirects, bot_blocked, item_count, etc.",
      "type": "object"
    },
    "failure_category": {
      "enum": [
        "404_gone",
        "blocked_antibot",
        "paywall_login",
        "invalid_html",
        "no_articles_found",
        "extraction_failed",
        "feed_validation_failed",
        "timeout",
        "network_error",
        "unexpected_error",
        "none"
      ],
      "type": "string"
    },
    "feed_id": {
      "type": "string"
    },
    "feed_name": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "new_url": {
      "type": "string"
    },
    "original_url": {
      "type": "string"
    },
    "repair_method": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "feed_id",
    "action"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}