{
  "name": "Story Images",
  "description": "Gives recent stories a lead image for thumbnails: re-reads the stored entry, else the article page's og:image. 60 stories per run, newest and most important first.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": { "dsl": "1.0.0", "name": "story_images", "version": "1.0", "namespace": "base44" },
    "do": [
      { "run_function": { "call": "invoke_backend_function", "with": { "function_name": "backfillStoryImages", "args": {} }, "then": "end" } }
    ]
  }
}
