{
  "name": "Dedupe Source Links (apply)",
  "description": "Deletes duplicate SourceItem links (same source + article). Dry run on 2026-09-25 found 10,370, 10,040 of them from Djinni BI. Articles, Sources and legacy tables are untouched.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 1 1 *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dedupe_source_links_apply",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "dedupe": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dedupeSourceLinks",
            "args": {
              "mode": "apply"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}