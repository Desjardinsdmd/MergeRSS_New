{
  "name": "Fetch Sources (shadow)",
  "description": "New-model fetch worker. Fetches each due Source once, writes deduplicated Articles and SourceItem links. Runs alongside the legacy Fetch RSS Feeds workflow until cutover.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "5,15,25,35,45,55 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "fetch_sources_shadow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "fetch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fetchSources",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}