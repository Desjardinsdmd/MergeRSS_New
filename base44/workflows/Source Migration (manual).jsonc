{
  "name": "Source Migration (manual)",
  "description": "Feed to Source/Subscription migration. Args default to dry_run; switch to mode apply only after reviewing the dry-run report in SystemHealth.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 1 1 *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "source_migration_manual",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "migrateToSources",
            "args": {
              "mode": "dry_run"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}