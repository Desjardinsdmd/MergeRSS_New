{
  "name": "Mailgun Replay (manual)",
  "description": "Admin diagnostic: replays the latest stored message for dylan.reads@mergerss.com to the webhook. Run now only.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 1 1 *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "mailgun_replay",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "newsletterInbox",
            "args": {
              "action": "diagnose",
              "hours": 1,
              "replay_recipient": "dylan.reads@mergerss.com"
            }
          },
          "then": "end"
        }
      }
    ]
  }
}