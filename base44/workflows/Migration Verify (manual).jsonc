{
  "name": "Migration Verify (manual)",
  "description": "Read-only: compares legacy FeedItems (90 days) with migrated SourceItem links per subscription and checks Source/Article references.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 4 1 1 *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migration_verify_manual",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "verify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "verifyMigration",
            "args": {
              "days": 90
            }
          },
          "then": "end"
        }
      }
    ]
  }
}