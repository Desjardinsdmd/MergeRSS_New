{
  "name": "Hourly Daily Rollups",
  "description": "Recomputes FeedDailyRollup rows (today + yesterday) for feeds fetched in the last 3h. Powers Rising Signals and change-over-time reporting at constant query cost.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "20 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hourly_daily_rollups",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "rollupFeedDays",
            "args": {
              "mode": "incremental",
              "days_back": 2
            }
          },
          "then": "end"
        }
      }
    ]
  }
}